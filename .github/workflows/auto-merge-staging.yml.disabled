name: Auto-Merge to Staging (Alternative)

# This workflow automatically merges dev into staging when CI passes
# Use this if you want automatic merging without PR review

on:
  workflow_run:
    workflows: ["CI Pipeline"]
    types:
      - completed
    branches:
      - dev

jobs:
  auto-merge-staging:
    runs-on: ubuntu-latest
    # Only run if the CI pipeline succeeded
    if: ${{ github.event.workflow_run.conclusion == 'success' }}

    steps:
      - name: Checkout repository
        uses: actions/checkout@v4
        with:
          fetch-depth: 0
          token: ${{ secrets.GITHUB_TOKEN }}

      - name: Configure Git
        run: |
          git config user.name "GitHub Actions Bot"
          git config user.email "actions@github.com"

      - name: Merge dev into staging
        run: |
          # Fetch all branches
          git fetch origin dev:dev
          git fetch origin staging:staging

          # Checkout staging
          git checkout staging

          # Merge dev into staging
          git merge dev --no-ff -m "Auto-merge: dev → staging after successful CI"

          # Push to staging
          git push origin staging

      - name: Create Deployment Notification
        if: success()
        run: |
          echo "✅ Successfully merged dev into staging"
          echo "Commit: ${{ github.event.workflow_run.head_sha }}"
          echo "Triggered by: ${{ github.event.workflow_run.head_commit.author.name }}"
